---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import StatusBar from '../components/StatusBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getSiteSettings } from '../lib/content';
import { farmJsonLd } from '../lib/seo';
import defaultShareImage from '../assets/photos/herd-pasture.jpg';

interface Props {
  title: string;
  description: string;
  /** Photo shown when the page is shared on Facebook etc. Defaults to the herd on pasture. */
  image?: ImageMetadata;
  /** Keep the page out of search results (404, form thank-you). */
  noindex?: boolean;
}
const { title, description, image = defaultShareImage, noindex = false } = Astro.props;
const settings = await getSiteSettings();
const fullTitle = Astro.url.pathname === '/' ? title : `${title} · ${settings.farmName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const share = await getImage({ src: image, width: 1200, format: 'jpg', quality: 70 });
const shareUrl = new URL(share.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content={String(share.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(share.attributes.height ?? '')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1f3b2b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(farmJsonLd(settings, Astro.site!))} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <StatusBar />
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 0; z-index: 50; background: var(--card); padding: 0.5rem 1rem; }
  .skip:focus { left: 1rem; top: 3rem; }
</style>
