---
import type { CollectionEntry } from 'astro:content';
import AnimalCard from './AnimalCard.astro';

interface Props { animals: CollectionEntry<'animals'>[] }
const { animals } = Astro.props;
---

<div class="grid">
  {animals.map((a) => <AnimalCard animal={a.data} />)}
</div>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 1rem; }
</style>
