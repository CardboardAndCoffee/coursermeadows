---
// Herd Book-style page header: title and intro, with an optional photo beside it.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  kicker?: string;
  title: string;
  lede?: string;
  photo?: { src: ImageMetadata; alt: string };
}
const { kicker, title, lede, photo } = Astro.props;
---

<header class:list={['wrap', 'intro', { 'has-photo': photo }]}>
  <div class="stack text">
    {kicker && <p class="kicker">{kicker}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
  {photo && (
    <Image src={photo.src} alt={photo.alt} widths={[400, 640, 960, 1300]} sizes="(max-width: 760px) calc(100vw - 32px), 50vw" quality={65} loading="eager" fetchpriority="high" class="photo" />
  )}
</header>

<style>
  .intro { padding-block: clamp(32px, 5vw, 64px); display: grid; gap: 2rem 3.5rem; align-items: center; }
  .has-photo { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); }
  .text { align-content: center; }
  h1 { font-size: clamp(2.2rem, 1.5rem + 3.2vw, 3.8rem); }
  .intro :global(.photo) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius); }
  @media (max-width: 760px) { .has-photo { grid-template-columns: 1fr; } }
</style>
