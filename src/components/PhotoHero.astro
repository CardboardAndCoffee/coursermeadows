---
// Field Guide-style opener: a big farm photo with the title over it.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photo: { src: ImageMetadata; alt: string };
  kicker?: string;
  title: string;
  lede?: string;
}
const { photo, kicker, title, lede } = Astro.props;
---

<header class="hero">
  <Image src={photo.src} alt={photo.alt} widths={[480, 768, 1200, 1800]} sizes="100vw" quality={52} loading="eager" fetchpriority="high" class="hero-img" />
  <div class="wrap text">
    {kicker && <p class="kicker">{kicker}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</header>

<style>
  .hero { position: relative; min-height: clamp(340px, 56vw, 600px); display: grid; align-items: end; color: #fff; isolation: isolate; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgb(17 26 15 / 0.85), rgb(17 26 15 / 0.15) 65%); }
  .text { padding-block: clamp(28px, 5vw, 60px); display: grid; gap: 0.9rem; width: 100%; }
  .text > * { max-width: 46rem; }
  .kicker { color: #f0d59a; }
  h1 { color: #fff; }
  .lede { color: rgb(255 255 255 / 0.92); }
</style>
