---
// "Visit the farm store" band near the bottom of most pages.
import { getSiteSettings } from '../lib/content';
import { describeHours } from '../lib/store-status';

interface Props { heading?: string; text?: string }
const s = await getSiteSettings();
const {
  heading = 'Visit the farm store',
  text = `Raw milk and yogurt, free-range eggs, grass-fed beef, pastured pork and chicken, and maple syrup. Open ${describeHours(s.hours).join(', ').toLowerCase()} at ${s.address.street}, ${s.address.town}.`,
} = Astro.props;
const tel = s.phone.replace(/[^\d+]/g, '');
---

<section class="band">
  <div class="wrap inner">
    <div class="stack">
      <h2>{heading}</h2>
      <p>{text}</p>
    </div>
    <div class="call">
      <span class="kicker">Call to reserve</span>
      <a class="phone" href={`tel:${tel}`}>{s.phone}</a>
    </div>
  </div>
</section>

<style>
  .band { background: var(--moss); color: var(--on-dark); margin-top: clamp(36px, 6vw, 72px); }
  .inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1.2rem 3rem; align-items: center; padding-block: clamp(28px, 4vw, 44px); }
  h2 { color: var(--on-dark); font-size: var(--step-2); }
  p { max-width: 60ch; opacity: 0.92; }
  .call { display: grid; gap: 0.2rem; }
  .call .kicker { color: #e6c98a; }
  .phone { font-family: var(--font-label); font-weight: 700; font-size: 1.9rem; color: var(--on-dark); text-decoration: none; font-variant-numeric: tabular-nums; }
  @media (max-width: 700px) { .inner { grid-template-columns: 1fr; } }
</style>
