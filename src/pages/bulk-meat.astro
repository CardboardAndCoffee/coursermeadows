---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import ProductList from '../components/ProductList.astro';
import CallBand from '../components/CallBand.astro';
import { getProducts } from '../lib/content';
import licorice from '../assets/photos/licorice.jpg';

const bulk = await getProducts('shares');
---

<Base title="Beef Shares & Fresh Chicken" description="Whole and half shares of 100% grass-fed beef, and fresh pastured chicken on processing days, from Courser Meadows in Warner, NH.">
  <PageIntro
    kicker="Buy in bulk"
    title="Beef shares and fresh chicken"
    lede="If you're interested in having meat always on hand, right in your own freezer, at a discounted price, consider purchasing a whole or half share of beef or bulk up on fresh chicken during our processing dates!"
    photo={{ src: licorice, alt: 'Licorice, a black Lowline Angus cow, standing in a pasture' }}
  />

  <section class="wrap cols">
    <div class="prose">
      <h2>Grass-fed beef shares</h2>
      <p>We offer beef from our 100% grass-fed and finished Dexters, Lowline Angus, and Irish Jerseys. Our cattle are on rotational pasture May to November (if Mother Nature allows!) and hay fed from our own fields the remainder of the year.</p>
      <p>These grass-fed cows have delicious meat, and since these are small breeds with high carcass yields, studies have shown that their cuts are slightly smaller and have smaller striations in the muscles, and thus are generally more tender compared to larger beef breeds. Smaller statured cattle also allow people to purchase a whole or half side of beef for less, but with a great variety of cuts, burgers, and roasts to take home.</p>
      <p>We sell our beef USDA inspected, and shares typically contain approximately 50% steaks and 50% ground and roasts, but custom cutting is available to your specifications with a reservation (we are happy to go over the cut sheet with you). Processing and packaging is included in the price.</p>
      <p>A $100 deposit is required to reserve your share. Final weight is determined at the butcher.</p>
      <h2>Fresh pastured chicken</h2>
      <p>Broilers at Courser Meadows are raised on pasture and fed 100% certified organic feed. Since they have room to move around and are allowed to browse on a diverse diet of grasses, seeds, and insects, they have great flavor! As with all our animals, we strive to raise them in a humane and stress-free environment. Broilers range from 3 to 6 lbs and are available fresh 3 or 4 times from June until October.</p>
      <p>Call or email to reserve yours (10% discount for reservations of fresh chicken) or to find out our next processing date. Broilers are offered frozen from the farm store the remainder of the year, as available.</p>
    </div>
    <aside class="stack side">
      <ProductList products={bulk} heading="Reserve ahead" />
      <p class="panel">Call or email for current pricing and to reserve. Our beef is also sold in our farm store as individual cuts, burger, and roasts, year round, as available.</p>
    </aside>
  </section>

  <CallBand />
</Base>

<style>
  .cols { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 2rem 4rem; padding-block: 1rem; }
  .cols .prose h2:first-child { margin-top: 0; }
  .side { align-content: start; position: sticky; top: 3.5rem; }
  @media (max-width: 800px) { .cols { grid-template-columns: 1fr; } .side { position: static; } }
</style>
