---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import AnimalGrid from '../components/AnimalGrid.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { getAnimals } from '../lib/content';
import fern from '../assets/photos/fern.jpg';

const forSale = await getAnimals({ species: 'cattle', saleStatus: ['available', 'reserved'] });
---

<Base title="Cattle for Sale" description="Mini cattle for sale from Courser Meadows in Warner, NH. Calves sold weaned, halter- and lead-trained, with health testing. Join the wait list.">
  <PageIntro
    kicker="Livestock for sale"
    title="Cattle for sale"
    lede="We offer calves for sale each year and sometimes have mature cattle available. Everything is sold halter- and lead-trained, weaned, and with health testing if old enough."
    photo={{ src: fern, alt: 'Fern, a small black cow, standing in a fenced pasture' }}
  />

  <section class="section wrap">
    <div class="section-head"><h2>Available now</h2><span class="data">{forSale.length} listed</span></div>
    {forSale.length > 0 ? (
      <AnimalGrid animals={forSale} />
    ) : (
      <div class="panel empty">
        <p><b>Nothing available right now.</b> New calves come along through the year. Join the wait list below and we'll get in touch when we have what you're looking for.</p>
      </div>
    )}
  </section>

  <section class="section wrap terms">
    <div class="stack">
      <h2>Buying from us</h2>
      <ul>
        <li>All cattle are sold halter- and lead-trained and weaned, with health testing if they're old enough. Our whole herd tests negative every year for TB, Brucellosis, Johne's, and BLV.</li>
        <li>Bred animals are confirmed by BioPRYN or by vet palpation.</li>
        <li>We don't ship with commercial carriers. Pick up at the farm, or we can usually deliver within New England for a fee.</li>
        <li>Not sure if mini or small-breed cattle are right for you? Email us. We're happy to talk it through.</li>
      </ul>
    </div>
  </section>

  <section class="section wrap" id="waitlist">
    <InquiryForm form="cattle-waitlist" heading="Join the cattle wait list" intro="Tell us what you're looking for and we'll be in touch when we have a match." />
  </section>
</Base>

<style>
  .empty p { max-width: 62ch; }
  .terms ul { margin: 0; padding-left: 1.2em; display: grid; gap: 0.6rem; max-width: 66ch; }
  .terms h2 { font-size: var(--step-2); }
</style>
