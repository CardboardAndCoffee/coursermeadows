---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import AnimalGrid from '../components/AnimalGrid.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { getAnimals } from '../lib/content';
import fern from '../assets/photos/fern.jpg';

const forSale = await getAnimals({ species: 'cattle', saleStatus: ['available', 'reserved'] });
---

<Base title="Cattle for Sale" description="Mini cattle for sale from Courser Meadows in Warner, NH. Calves sold weaned, halter- and lead-trained, with health testing. Join the wait list.">
  <PageIntro
    kicker="Livestock for sale"
    title="Cattle for sale"
    lede="Courser Meadows offers calves for sale each year and occasionally has mature cattle available. All cattle are sold halter and lead trained, weaned, and with health testing if old enough."
    photo={{ src: fern, alt: 'Fern, a small black cow, standing in a fenced pasture' }}
  />

  <section class="section wrap">
    <div class="section-head"><h2>Available now</h2><span class="data">{forSale.length} listed</span></div>
    {forSale.length > 0 ? (
      <AnimalGrid animals={forSale} />
    ) : (
      <div class="panel empty">
        <p><b>Nothing available right now.</b> We have breeding, dairy, pet, and beef livestock available throughout the year, so fill out the form below to be put on our waiting list.</p>
      </div>
    )}
  </section>

  <section class="section wrap terms">
    <div class="stack">
      <h2>Buying from us</h2>
      <ul>
        <li>All cattle are sold halter and lead trained, weaned, and with health testing if old enough. Our entire herd tests negative for TB, Brucellosis, Johne's, and BLV annually.</li>
        <li>Bred animals will be confirmed by either BioPRYN or palpation by vet.</li>
        <li>We currently do not ship our cattle with commercial carriers. Any animals bought would need to be picked up by you on our farm, or we can usually transport ourselves within New England for a fee.</li>
        <li>Email us if you have questions or are trying to decide if mini/small breed cattle are for you.</li>
      </ul>
    </div>
  </section>

  <section class="section wrap" id="waitlist">
    <InquiryForm form="cattle-waitlist" heading="Join the cattle wait list" intro="Tell us what you're looking for and we'll be in touch when we have a match." />
  </section>
</Base>

<style>
  .empty p { max-width: 62ch; }
  .terms ul { margin: 0; padding-left: 1.2em; display: grid; gap: 0.6rem; max-width: 66ch; }
  .terms h2 { font-size: var(--step-2); }
</style>
