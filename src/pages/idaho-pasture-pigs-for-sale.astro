---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import ProductList from '../components/ProductList.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { getProducts } from '../lib/content';
import p1 from '../assets/photos/piglets-1.jpg';
import p2 from '../assets/photos/piglets-2.jpg';
import p3 from '../assets/photos/piglets-3.jpg';
import p5 from '../assets/photos/piglets-5.jpg';
import p6 from '../assets/photos/piglets-6.jpg';

const prices = await getProducts('piglets');
const gallery = [
  { src: p2, alt: 'Two red piglets and a spotted one rooting through the hay' },
  { src: p3, alt: 'Black and spotted piglets curled up asleep in the hay' },
  { src: p5, alt: 'Red and spotted piglets sleeping in a row' },
  { src: p6, alt: 'A mixed litter of black, red, and spotted piglets in the hay' },
];
---

<Base title="Idaho Pasture Pigs for Sale" description="Registered Idaho Pasture Pig piglets for sale in Warner, NH: feeder pigs and breeding-quality gilts and boars. Join the wait list.">
  <PageIntro
    kicker="Livestock for sale"
    title="Idaho Pasture Pigs for sale"
    lede="We have Spring/Summer 2026 litters here at Courser Meadows, ready to go early July to early August. All litters are from registered IPP parents."
    photo={{ src: p1, alt: 'A litter of red and spotted Idaho Pasture Pig piglets piled together in the hay' }}
  >
    <div class="btn-row"><a class="btn" href="#waitlist">Join the wait list</a><a class="btn alt" href="/idaho-pasture-pigs/">Meet the parents</a></div>
  </PageIntro>

  <section class="section wrap two">
    <div class="stack">
      <div class="section-head"><h2>Spring/Summer 2026</h2><span class="pill available">Taking reservations</span></div>
      <ProductList products={prices} />
      <p class="muted">We will have a limited selection of registered breeding stock available as well as feeders. Email us or fill out the form below to let us know what you are looking for and to get on our wait-list.</p>
    </div>
    <div class="stack">
      <div class="section-head"><h2>New to IPPs?</h2></div>
      <p>Our guide covers what we've learned about wallows, grazing, fencing, housing, and feeding, including how much to feed a feeder pig month by month.</p>
      <p><a class="btn alt" href="/guides/raising-idaho-pasture-pigs/">Read the guide</a></p>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head"><h2>Some of the piglets from past litters</h2></div>
    <div class="gallery">
      {gallery.map((g) => <Image src={g.src} alt={g.alt} widths={[400, 700]} sizes="(max-width: 700px) 50vw, 25vw" />)}
    </div>
  </section>

  <section class="section wrap" id="waitlist">
    <InquiryForm form="piglet-waitlist" heading="Get on the piglet wait list" intro="Let us know what you're looking for and roughly when, and we'll be in touch." />
  </section>
</Base>

<style>
  .two { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 2rem 4rem; }
  .muted { color: var(--muted); max-width: 60ch; }
  .gallery { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.6rem; }
  .gallery :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 4px; }
  @media (max-width: 760px) { .two { grid-template-columns: 1fr; } .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
