        "breed": {
          "type": "text",
          "display_name": "Breed",
          "pos": 7,
          "description": "e.g. \"75% Mini Jersey, 25% Dexter\""
        },
        "born": {
          "type": "datetime",
          "display_name": "Date of birth",
          "pos": 8,
          "disable_time": true
        },
        "color": {
          "type": "text",
          "display_name": "Color",
          "pos": 9
        },
        "genetics": {
          "type": "text",
          "display_name": "Genetics & testing",
          "pos": 10,
          "description": "e.g. \"A1/A2, Polled, Chondro/PHA Negative\""
        },
        "height": {
          "type": "text",
          "display_name": "Height",
          "pos": 11,
          "description": "e.g. \"40 in at the withers\""
        }
      }
    },
