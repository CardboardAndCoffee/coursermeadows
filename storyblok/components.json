{
  "components": [
    {
      "name": "site_settings",
      "display_name": "Farm info & hours",
      "is_root": true,
      "is_nestable": false,
      "schema": {
        "tab_status": {
          "type": "tab",
          "display_name": "Open / closed",
          "keys": [
            "status_override",
            "override_message",
            "override_until"
          ]
        },
        "status_override": {
          "type": "option",
          "display_name": "Store status",
          "pos": 0,
          "required": true,
          "default_value": "auto",
          "options": [
            {
              "value": "auto",
              "name": "Follow the regular hours"
            },
            {
              "value": "open",
              "name": "Show OPEN (override)"
            },
            {
              "value": "closed",
              "name": "Show CLOSED (override)"
            }
          ],
          "description": "Leave on \"Follow the regular hours\" unless something unusual is happening."
        },
        "override_message": {
          "type": "text",
          "display_name": "Message while overridden",
          "pos": 1,
          "max_length": 80,
          "description": "Shown in the status bar, e.g. \"Closed today — snowed in\"."
        },
        "override_until": {
          "type": "datetime",
          "display_name": "Override ends",
          "pos": 2,
          "description": "Optional. After this, the status goes back to the regular hours by itself."
        },
        "tab_hours": {
          "type": "tab",
          "display_name": "Hours",
          "keys": [
            "hours",
            "hours_note",
            "closures"
          ]
        },
        "hours": {
          "type": "bloks",
          "display_name": "Regular weekly hours",
          "pos": 3,
          "restrict_components": true,
          "component_whitelist": [
            "hours_row"
          ],
          "minimum": 1
        },
        "hours_note": {
          "type": "text",
          "display_name": "Note under the hours",
          "pos": 4,
          "max_length": 120
        },
        "closures": {
          "type": "bloks",
          "display_name": "Holiday closures",
          "pos": 5,
          "restrict_components": true,
          "component_whitelist": [
            "closure"
          ]
        },
        "tab_contact": {
          "type": "tab",
          "display_name": "Contact",
          "keys": [
            "farm_name",
            "phone",
            "email",
            "street",
            "town",
            "state",
            "zip",
            "map_url",
            "facebook_url"
          ]
        },
        "farm_name": {
          "type": "text",
          "display_name": "Farm name",
          "pos": 6,
          "required": true
        },
        "phone": {
          "type": "text",
          "display_name": "Phone",
          "pos": 7,
          "required": true
        },
        "email": {
          "type": "text",
          "display_name": "Email",
          "pos": 8,
          "required": true
        },
        "street": {
          "type": "text",
          "display_name": "Street address",
          "pos": 9,
          "required": true
        },
        "town": {
          "type": "text",
          "display_name": "Town",
          "pos": 10,
          "required": true
        },
        "state": {
          "type": "text",
          "display_name": "State",
          "pos": 11,
          "required": true
        },
        "zip": {
          "type": "text",
          "display_name": "ZIP",
          "pos": 12,
          "required": true
        },
        "map_url": {
          "type": "text",
          "display_name": "Google Maps link",
          "pos": 13
        },
        "facebook_url": {
          "type": "text",
          "display_name": "Facebook page",
          "pos": 14
        }
      }
    },
