    {
      "name": "closure",
      "display_name": "Closure",
      "is_root": false,
      "is_nestable": true,
      "preview_field": "label",
      "schema": {
        "label": {
          "type": "text",
          "display_name": "Message",
          "pos": 0,
          "required": true,
          "description": "e.g. \"Closed for Thanksgiving\""
        },
        "from": {
          "type": "datetime",
          "display_name": "First day closed",
          "pos": 1,
          "required": true,
          "disable_time": true
        },
        "to": {
          "type": "datetime",
          "display_name": "Last day closed",
          "pos": 2,
          "required": true,
          "disable_time": true
        }
      }
    },
    {
      "name": "product",
      "display_name": "Product",
      "is_root": true,
      "is_nestable": false,
      "preview_field": "name",
      "schema": {
        "name": {
          "type": "text",
          "display_name": "Name",
          "pos": 0,
          "required": true,
          "description": "e.g. \"Ground beef\""
        },
        "category": {
          "type": "option",
          "display_name": "Category",
          "pos": 1,
          "required": true,
          "options": [
            {
              "value": "dairy",
              "name": "Dairy"
            },
            {
              "value": "eggs",
              "name": "Eggs"
            },
            {
              "value": "beef",
              "name": "Beef"
            },
            {
              "value": "pork",
              "name": "Pork"
            },
            {
              "value": "lamb",
              "name": "Lamb"
            },
            {
              "value": "poultry",
              "name": "Poultry"
            },
            {
              "value": "maple",
              "name": "Maple syrup"
            },
            {
              "value": "piglets",
              "name": "Piglets"
            },
            {
              "value": "shares",
              "name": "Bulk shares"
            }
          ]
        },
        "price": {
          "type": "number",
          "display_name": "Price ($)",
          "pos": 2,
          "description": "Leave empty for \"call for price\".",
          "decimals": 2
        },
        "unit": {
          "type": "text",
          "display_name": "Per",
          "pos": 3,
          "description": "e.g. lb, dozen, quart, each"
        },
        "price_note": {
          "type": "text",
          "display_name": "Price note",
          "pos": 4,
          "description": "e.g. \"+ $2 jar deposit\" or \"~4–6 lb each\""
        },
        "availability": {
          "type": "option",
          "display_name": "Availability",
          "pos": 5,
          "required": true,
          "default_value": "in_stock",
          "options": [
            {
              "value": "in_stock",
              "name": "In stock"
            },
            {
              "value": "limited",
              "name": "Limited — call ahead"
            },
            {
              "value": "sold_out",
              "name": "Sold out"
            },
            {
              "value": "seasonal",
              "name": "Seasonal"
            },
            {
              "value": "reserve_only",
              "name": "By reservation"
            }
          ]
        },
        "availability_note": {
          "type": "text",
          "display_name": "Availability note",
          "pos": 6,
          "description": "e.g. \"Back in early November\""
        }
      }
    },
